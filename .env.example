# Generate local secrets first: python scripts/init_env.py
PUBLIC_URL=http://localhost:8000
DOMAIN=research.example.com
# Host-only ports; defaults also apply to existing .env files without these lines.
NEXUS_API_PORT=18473
NEXUS_N8N_PORT=18474
DATABASE_URL=postgresql+psycopg://nexus:replace-db-password@postgres:5432/nexus
POSTGRES_PASSWORD=replace-db-password
API_TOKEN=replace-with-a-unique-random-secret
WORKER_TOKEN=replace-with-another-random-secret
OWNER_PASSWORD=replace-with-your-owner-login-secret
OAUTH_CLIENT_ID=research-nexus-chatgpt
OAUTH_CLIENT_SECRET=replace-with-your-oauth-client-secret
OAUTH_REDIRECT_URIS=["https://chatgpt.com/connector_platform_oauth_redirect"]
OPENAI_API_KEY=
RESEARCH_MODEL=gpt-5-mini
LIBRARIAN_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_TOOL_CALLS=3
MAX_OUTPUT_TOKENS=6000
N8N_ENCRYPTION_KEY=replace-with-another-random-secret
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.39.6
