{
  "name": "Research Nexus \u2014 autonomous research",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "claim-next-stage",
      "name": "Claim next stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/internal/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 540000
        }
      },
      "retryOnFail": false
    },
    {
      "id": "work-available",
      "name": "Work available",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Work available",
              "leftValue": "={{ $json.available }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "research-stage",
      "name": "Research stage",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Research stage",
              "leftValue": "={{ $json.stage }}",
              "rightValue": "research",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "research-agent",
      "name": "Research agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://api:8000/internal/jobs/\" + $json.job_id + \"/research\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 540000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { lease_token: $json.lease_token } }}"
      },
      "retryOnFail": false
    },
    {
      "id": "librarian",
      "name": "Librarian",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ \"http://api:8000/internal/jobs/\" + $json.job_id + \"/librarian\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 540000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { lease_token: $json.lease_token } }}"
      },
      "retryOnFail": false
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Claim next stage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim next stage": {
      "main": [
        [
          {
            "node": "Work available",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Work available": {
      "main": [
        [
          {
            "node": "Research stage",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Research stage": {
      "main": [
        [
          {
            "node": "Research agent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Librarian",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 600,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
